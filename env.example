# ===== Telegram =====
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# ===== Модель ИИ (OpenAI или любой OpenAI-совместимый API) =====
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
# Свой эндпоинт, если модель хостится не в OpenAI:
# OPENAI_BASE_URL=https://api.your-provider.com/v1
# Модели, на которые бот переключится, если основная недоступна ключу:
# OPENAI_FALLBACK_MODELS=gpt-5,gpt-4o

# Параметры рассуждений (семейство GPT-5.6)
OPENAI_REASONING_EFFORT=medium    # none/low/medium/high/xhigh/max
# OPENAI_REASONING_MODE=pro       # standard/pro — pro это режим Luna Pro
OPENAI_VERBOSITY=medium           # low/medium/high — длина ответа
OPENAI_MAX_OUTPUT_TOKENS=8000

# ===== Брендинг =====
BRAND_NAME=ChatGPT Luna
MODEL_DISPLAY_NAME=Luna       # имя модели ИИ в сообщениях и отчётах

# ===== Распознавание речи (OpenAI Audio API) =====
STT_LANGUAGE=auto            # auto/ru/en/... — авто или фиксированный язык
STT_MODEL=gpt-transcribe     # рекомендованная OpenAI модель расшифровки
STT_FALLBACK_MODELS=whisper-1  # если ключу недоступна основная модель
STT_TIMESTAMPS=true          # таймкоды сегментов; их отдаёт только whisper-1
# Если расшифровка живёт на другом провайдере, чем модель анализа:
# STT_API_KEY=...
# STT_BASE_URL=https://api.openai.com/v1

# ===== Подготовка аудио (FFmpeg) =====
AUDIO_BITRATE=64k         # битрейт моно-MP3 для расшифровки
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SECONDS=600   # длина куска, на которые режется длинное аудио

# ===== Лимиты =====
MAX_UPLOAD_SIZE_MB=24     # лимит одной загрузки в OpenAI Audio API (макс. 25)
MAX_FILE_SIZE_MB=500      # предохранитель на размер скачанного файла
MAX_AUDIO_DURATION_MINUTES=120
MAX_REQUESTS_PER_MINUTE=5
MAX_REQUESTS_PER_HOUR=20
MAX_MESSAGE_LENGTH=4000

# ===== Cookies (для закрытого/возрастного контента) =====
# Экспортируйте cookies в формате Netscape (например, расширением Get cookies.txt)
# INSTAGRAM_COOKIES_FILE=./cookies/instagram.txt
# TIKTOK_COOKIES_FILE=./cookies/tiktok.txt
# Либо те же cookies строкой в base64 — удобно там, где файл не примонтировать:
#   base64 -w0 instagram_cookies.txt
# INSTAGRAM_COOKIES_B64=...
# TIKTOK_COOKIES_B64=...

# ===== Сбор материала по аккаунтам =====
# Через запятую: tiktok:@user, instagram:user, ссылка на профиль
# или composio:instagram — лента вашего аккаунта через официальный API
SOURCE_ACCOUNTS=
SOURCE_SCAN_INTERVAL_HOURS=24     # 0 — отключить плановый сбор
SOURCE_MAX_ITEMS_PER_ACCOUNT=3    # сколько новых публикаций брать за проход
# ADMIN_CHAT_ID=123456789         # чат для сводок и команды /scan
# DATABASE_PATH=/data/collected.db  # положите на volume, иначе база теряется при редеплое

# ===== Composio (официальный Instagram Graph API) =====
# Нужен для источника composio:instagram — ключ берётся в дашборде Composio
# COMPOSIO_API_KEY=
# COMPOSIO_CONNECTED_ACCOUNT_ID=   # если подключено несколько аккаунтов
# COMPOSIO_IG_USER_ID=me           # или числовой ID вашего бизнес-аккаунта
# COMPOSIO_VIDEOS_ONLY=true        # false — собирать и фото-публикации

# ===== Визуальный разбор (кадры из видео) =====
VISION_ENABLED=true             # отправлять кадры модели вместе с расшифровкой
VISION_FRAMES=4                 # сколько кадров брать из ролика
VISION_FRAME_WIDTH=640          # ширина кадра в пикселях
VISION_MAX_DURATION_MINUTES=20  # для более длинных роликов кадры не берём
VISION_MAX_HEIGHT=480           # разрешение превью, скачиваемого ради кадров

# ===== Система =====
WORKDIR=./data
LOG_LEVEL=INFO
CLEAN_WORKDIR_ON_START=true   # чистить временные файлы прошлого запуска

# ===== Webhook (необязательно; по умолчанию polling) =====
# USE_WEBHOOK=true                 # включить webhook (иначе polling)
# WEBHOOK_BASE_URL=https://your-domain.com
#   На Railway можно не задавать: адрес берётся из RAILWAY_PUBLIC_DOMAIN,
#   а порт — из PORT, который платформа подставляет сама.
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=random-string     # проверка заголовка от Telegram
# PORT=8000
